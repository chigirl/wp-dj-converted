# =============================================================
# Environment Variables — Jacob Black React App
# =============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================

# ---------------------------------------------------------------------------
# API Base URL
# ---------------------------------------------------------------------------
# Point to your custom REST API (Node/Express, Django, Laravel, etc.)
# All ENDPOINTS in src/config/api.js are built from this base URL.
# Example: https://api.jacobblack.com/api
REACT_APP_API_BASE_URL=http://localhost:5000/api

# ---------------------------------------------------------------------------
# WordPress REST API (headless CMS option)
# ---------------------------------------------------------------------------
# If you keep WordPress as a headless CMS, set this to your WP site's
# REST API root. Used in src/config/api.js as WP_API_URL.
# Example: https://cms.jacobblack.com/wp-json/wp/v2
REACT_APP_WP_API_URL=https://your-wordpress-site.com/wp-json/wp/v2

# ---------------------------------------------------------------------------
# Contact Form Endpoint
# ---------------------------------------------------------------------------
# URL that receives POST requests from the contact form (Contacts.js).
# Overrides the default derived from REACT_APP_API_BASE_URL.
# For Formspree: https://formspree.io/f/YOUR_FORM_ID
REACT_APP_CONTACT_ENDPOINT=http://localhost:5000/api/contact

# ---------------------------------------------------------------------------
# Supabase (if using Supabase as your database/backend)
# ---------------------------------------------------------------------------
# REACT_APP_SUPABASE_URL=https://xxxx.supabase.co
# REACT_APP_SUPABASE_ANON_KEY=your-public-anon-key

# ---------------------------------------------------------------------------
# Firebase (if using Firebase)
# ---------------------------------------------------------------------------
# REACT_APP_FIREBASE_API_KEY=
# REACT_APP_FIREBASE_AUTH_DOMAIN=
# REACT_APP_FIREBASE_PROJECT_ID=
# REACT_APP_FIREBASE_STORAGE_BUCKET=
# REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
# REACT_APP_FIREBASE_APP_ID=
